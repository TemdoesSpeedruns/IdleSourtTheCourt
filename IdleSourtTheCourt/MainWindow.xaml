<Window x:Class="IdleKingdom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Idle Kingdom" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="VillageNameText"
                   Text="Je dorp"
                   FontSize="20"
                   FontWeight="Bold"
                   Grid.Row="0"
                   Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10" HorizontalAlignment="Left" Spacing="20">
            <StackPanel>
                <TextBlock Text="Goud" FontWeight="SemiBold"/>
                <TextBlock x:Name="GoldText" Text="0"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Hout" FontWeight="SemiBold"/>
                <TextBlock x:Name="WoodText" Text="0"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Bewoners" FontWeight="SemiBold"/>
                <TextBlock x:Name="PopulationText" Text="5"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Inkomen" FontWeight="SemiBold"/>
                <TextBlock x:Name="IncomeText" Text="+1 goud / seconde   |   +0 hout / seconde"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top" Spacing="10">
                <Button x:Name="UpgradeButton"
                        Content="Upgrade (50 goud, 5 bewoners)"
                        Width="220"
                        Height="40"
                        Click="UpgradeButton_Click"/>

                <!-- Visitor popup area -->
                <StackPanel x:Name="VisitorPopup" Margin="0,10,0,0">
                    <TextBlock x:Name="EventText"
                               Text="Een nieuwe bezoeker is aangekomen!"
                               TextWrapping="Wrap"/>

                    <StackPanel x:Name="VisitorButtonsPanel" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="YesButton"
                                Content="Ja"
                                Width="100"
                                Height="40"
                                Margin="5"
                                Click="YesButton_Click"/>

                        <Button x:Name="NoButton"
                                Content="Nee"
                                Width="100"
                                Height="40"
                                Margin="5"
                                Click="NoButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Clicker element -->
                <Button x:Name="ClickButton"
                        Content="Tap (+1 goud)"
                        Width="120"
                        Height="40"
                        Margin="0,10,0,0"
                        Click="ClickButton_Click"/>
            </StackPanel>

            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Debug / Info" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="(Extra UI area)" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>